# Server only. Load into the API and worker environment; never commit values.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/database?sslmode=verify-full
# Direct connection for isolated verification schema setup/cleanup only.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.region.aws.neon.tech/database?sslmode=verify-full
DB_POOL_MIN=0
DB_POOL_MAX=5
WORKER_DB_POOL_MIN=0
WORKER_DB_POOL_MAX=3
APP_SCHEMA=deadline_crush
CORS_ORIGINS=http://localhost:5173
PROBE_TOKEN=replace-with-random-secret
R2_ACCOUNT_ID=replace-account-id
R2_BUCKET=deadline-crush-phase0
R2_ACCESS_KEY_ID=replace-scoped-key
R2_SECRET_ACCESS_KEY=replace-scoped-secret
PHASE0_URL=http://127.0.0.1:8787
# Managed Auth values are pulled by neon deploy. Never expose database URLs.
NEON_AUTH_BASE_URL=https://example.neonauth.region.aws.neon.build/neondb/auth
NEON_AUTH_JWKS_URL=https://example.neonauth.region.aws.neon.build/neondb/auth/jwks
# Multipart capability lifetime (1–120 seconds). Server only.
R2_URL_TTL_SECONDS=60
