FROM deadline-crush-phase4
USER root
RUN uv pip install --python /opt/venv/bin/python pytest==9.2.0
COPY tests tests
COPY apps/api apps/api
COPY migrations migrations
COPY pytest.ini pytest.ini
COPY scripts/validation_feasibility.py scripts/validation_feasibility.py
RUN chown -R appuser:appuser /app/tests
USER appuser
ENV PYTHONDONTWRITEBYTECODE=1
CMD ["python", "-m", "pytest", "-q", "tests/test_validation_files.py", "tests/test_validation_links.py", "tests/test_validation_retrieval.py", "tests/test_validation_process.py", "tests/test_validation_live.py", "--tb=short", "-p", "no:cacheprovider"]
